{
  "repository": "brunnojob/trazormodel",
  "inputs": [
    ".proof/scenarios.json",
    "src/lib/money.ts",
    ".proof/money.ts"
  ],
  "cases": [
    {
      "name": "npm ci",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm ci"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "npm run typecheck",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run typecheck"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "npm run build",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run build"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Convert decimal money exactly and reject unsafe monetary inputs",
      "argv": [
        "node",
        ".proof/money.ts"
      ],
      "contains": [
        "\"minor\":999999999999",
        "\"invalid_values_rejected\":8"
      ]
    }
  ]
}
